{
    "extends": ["next/core-web-vitals", "next/typescript"],
    "rules": {
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrors": "none"
            }
        ]
    },
    "overrides": [
        {
            // Brackets are escaped: an unescaped [slug] is a glob character
            // class, so "app/[slug]/page.tsx" would never match this route.
            //
            // MDX plugin options and remark/rehype AST nodes are loosely typed
            // upstream, so the escape hatches in these files are deliberate.
            "files": ["app/\\[slug\\]/page.tsx", "app/\\[slug\\]/mdx.ts"],
            "rules": {
                "@typescript-eslint/no-explicit-any": "off"
            }
        },
        {
            // Static export renders this at build time; next/image would need a
            // server or a custom loader.
            "files": ["app/\\[slug\\]/page.tsx"],
            "rules": {
                "@next/next/no-img-element": "off"
            }
        }
    ]
}
